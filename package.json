{
  "name": "nps-platform",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/h13/nps-platform#readme",
  "bugs": {
    "url": "https://github.com/h13/nps-platform/issues"
  },
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h13/nps-platform.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:schema": "wrangler d1 execute nps-platform --local --file=./sql/schema.sql",
    "db:seed": "wrangler d1 execute nps-platform --local --file=./sql/seed.sql",
    "db:setup": "pnpm run db:schema && pnpm run db:seed",
    "lint": "oxlint --fix src widget/src e2e",
    "lint:fix": "oxlint --fix src widget/src e2e",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p widget/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:widget": "vitest run --config widget/vitest.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260719.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.123.0"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
